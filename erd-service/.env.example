# 운영 환경변수 — 이 파일을 .env로 복사 후 값 입력 (.env는 git 제외)
# DATABASE_URL 미설정 시 pg-mem 인메모리 DB로 동작 (재시작 시 데이터 소실 — 개발/QA 전용)
DATABASE_URL=postgresql://사용자:비밀번호@localhost:5432/erd_service
JWT_SECRET=긴-무작위-문자열로-교체하세요
# PORT=8080
# 공유 링크는 기본적으로 로그인 없이 열람 가능하다(링크 = 그 다이어그램 하나에 대한 읽기 권한).
# 사내 전용 등으로 다시 잠그려면 아래를 켠다 — 링크 소지자도 로그인해야 열 수 있다.
# REQUIRE_SHARE_LOGIN=1
